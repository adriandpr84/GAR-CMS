#cloud-config
autoinstall:
  version: 1
  locale: es_ES.UTF-8
  keyboard:
    layout: es
  refresh-installer:
    update: false
  identity:
    hostname: {{ node.name }}
    username: {{ vm_user }}
    password: "{{ vm_password_hash }}"
    realname: Administrator
  ssh:
    install-server: true
    authorized-keys:
      - "{{ ssh_pub_key }}"
    allow-pw: true
  network:
    version: 2
    ethernets:
{% for net in node.networks %}
{% set nic_name = ['enp0s3', 'enp0s8', 'enp0s9', 'enp0s10'][loop.index0] %}
      {{ nic_name }}:
{% if net.type == 'nat' %}
        dhcp4: true
{% else %}
{% set global_net = networks | selectattr("name", "equalto", net.name) | first | default({}) %}
{% set nm = net.netmask | default(global_net.netmask | default('255.255.255.0')) %}
{% set gw = net.gateway | default(global_net.gateway | default('')) %}
{% set dns_list = net.dns | default(global_net.dns | default([])) %}
{% set cidr = "24" if nm == '255.255.255.0' else "16" %}
        dhcp4: false
        addresses:
          - {{ net.ip }}/{{ cidr }}
{% if gw %}
        gateway4: {{ gw }}
{% endif %}
{% if dns_list %}
        nameservers:
          addresses:
{% for d in dns_list %}
            - {{ d }}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
  storage:
    swap:
      size: 512M
    layout:
      name: direct
  updates: security
  early-commands:
    - ( FILE="/target/usr/bin/unattended-upgrade" ; until [ -e "$FILE" ] ; do sleep 1 ; done ; sed -i '1i#!/bin/true' "$FILE" ) &
  late-commands:
    - "sed -i '\\,^#!/bin/true$,d' /target/usr/bin/unattended-upgrade || true"
    - "curtin in-target -- systemctl disable apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true"
    - "curtin in-target -- curl --max-time 30 -sf http://{{ jumpstart_ip }}:{{ callback_port }}/node-ready?node={{ node.name }} || true"
  shutdown: poweroff