version: "3.8"

services:
{% for node in db_cluster_nodes %}
  {{ node.name }}:
    image: {{ db_image }}
    networks:
      {{ db_overlay_network }}:
        aliases:
          - {{ node.name }}
    environment:
      MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
      MYSQL_DATABASE: "{{ db_name }}"
      MYSQL_USER: "{{ db_user }}"
      MYSQL_PASSWORD: "{{ db_password }}"
      GALERA_CLUSTER_NAME: "{{ db_galera_cluster_name }}"
      GALERA_CLUSTER_ADDRESS: "gcomm://{{ db_cluster_nodes | map(attribute='name') | join(',') }}"
      GALERA_BOOTSTRAP: "{{ (loop.first) | ternary('yes', 'no') }}"
      GALERA_NODE_NAME: "{{ node.name }}"
      GALERA_NODE_ADDRESS: "{{ node.name }}"
      GALERA_MARIABACKUP_USER: "{{ db_mariabackup_user }}"
      GALERA_MARIABACKUP_PASSWORD: "{{ db_mariabackup_password }}"
    volumes:
      - {{ node.name }}_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "pidof", "mariadbd"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    deploy:
      replicas: 1
      restart_policy:
        condition: any
        delay: 10s
      placement:
        constraints:
          - node.hostname == {{ node.host }}

{% endfor %}

  db-lb:
    image: {{ haproxy_image }}
    networks:
      - {{ db_overlay_network }}
    configs:
      - source: db_haproxy_cfg_v3
        target: /usr/local/etc/haproxy/haproxy.cfg
    ports:
      - target: 3306
        published: {{ db_public_port }}
        protocol: tcp
        mode: ingress
    deploy:
      replicas: 1
      restart_policy:
        condition: any
      placement:
        constraints:
          - node.role == manager

networks:
  {{ db_overlay_network }}:
    driver: overlay
    attachable: true

volumes:
{% for node in db_cluster_nodes %}
  {{ node.name }}_data:
{% endfor %}

configs:
  db_haproxy_cfg_v3:
    file: {{ swarm_remote_dir }}/haproxy.cfg
