# Configuracion de agente SNMP — Gestionado por el Rol 5
agentaddress udp:161,udp6:[::]:161

# Permitir acceso de lectura a la comunidad desde la subred local de este nodo de forma dinamica
rocommunity comunidad-gar 192.168.0.0/16

syslocation Laboratorio_GAR_VirtualBox
syscontact equipo5@gar.local

# Extensiones de monitorizacion de servicios (Requisito 11)
# Esto permite a CheckMK obtener métricas sobre el estado de los servicios
proc nginx
proc dockerd
proc glusterd
proc mysqld
